{
  "name": "traffic-optimizer",
  "version": "0.1.0",
  "description": "Mobile-first departure planner with guarded traffic forecasts.",
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "dev": "vite",
    "api:dev": "wrangler dev --port 8787",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/unit.test.ts tests/windows.test.ts tests/ui.test.tsx",
    "test:e2e": "playwright test",
    "check": "npm run test:release && npm run typecheck && npm test && npm run test:db && npm run build && npm run test:budget",
    "deploy": "npm run release:publish",
    "release:publish": "node scripts/publish-release.mjs",
    "test:release": "node --test tests/release.test.mjs",
    "test:capacity": "node scripts/capacity-drill.mjs",
    "setup:db": "supabase migration up",
    "keys:push": "node scripts/generate-vapid.mjs",
    "test:db": "node tests/database.mjs",
    "worker:build": "WRANGLER_SEND_METRICS=false wrangler deploy --dry-run --outdir artifacts/worker",
    "test:budget": "npm run worker:build && node tests/budget.mjs && node tests/reminders.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@block65/webcrypto-web-push": "2.0.0",
    "@hookform/resolvers": "5.9.1",
    "@js-temporal/polyfill": "0.5.1",
    "@radix-ui/react-dialog": "1.1.23",
    "@supabase/supabase-js": "2.117.2",
    "@tanstack/react-query": "5.104.1",
    "lucide-react": "1.52.0",
    "mapbox-gl": "3.32.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.89.0",
    "zod": "3.25.76",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261005.1",
    "@electric-sql/pglite": "0.5.8",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.2",
    "miniflare": "5.20261001.0-alpha",
    "prettier": "3.9.9",
    "supabase": "2.119.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vitest": "5.0.3",
    "wrangler": "4.147.0"
  },
  "private": true
}
